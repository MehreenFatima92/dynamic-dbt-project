{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.12.3", "generated_at": "2026-09-11T05:31:36.939133Z", "invocation_id": "70a08e4c-b8d9-4efc-8d1f-7f5683212f90", "invocation_started_at": "2026-09-11T05:31:33.802989Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-11T05:31:36.704924Z", "completed_at": "2026-09-11T05:31:36.724963Z"}, {"name": "execute", "started_at": "2026-09-11T05:31:36.726938Z", "completed_at": "2026-09-11T05:31:36.726980Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.025259733200073242, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.dynamic_dbt_project.my_first_dbt_model", "compiled": true, "compiled_code": "/*\n    Welcome to your first dbt model!\n    Did you know that you can also configure models directly within SQL files?\n    This will override configurations stated in dbt_project.yml\n\n    Try changing \"table\" to \"view\" below\n*/\n\n\n\nwith source_data as (\n\n    select 1 as id\n    union all\n    select null as id\n\n)\n\nselect *\nfrom source_data\n\n/*\n    Uncomment the line below to remove records with null `id` values\n*/\n\n-- where id is not null", "relation_name": "\"dev\".\"main\".\"my_first_dbt_model\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-11T05:31:36.734633Z", "completed_at": "2026-09-11T05:31:36.736513Z"}, {"name": "execute", "started_at": "2026-09-11T05:31:36.738132Z", "completed_at": "2026-09-11T05:31:36.738154Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.005885124206542969, "adapter_response": {}, "message": null, "failures": null, "unique_id": "seed.dynamic_dbt_project.raw_orders", "compiled": null, "compiled_code": null, "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "202