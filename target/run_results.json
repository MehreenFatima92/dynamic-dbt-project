ngroup by id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-11T05:31:36.846465Z", "completed_at": "2026-09-11T05:31:36.855440Z"}, {"name": "execute", "started_at": "2026-09-11T05:31:36.857123Z", "completed_at": "2026-09-11T05:31:36.857149Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.013031959533691406, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.dynamic_dbt_project.daily_sales_summary", "compiled": true, "compiled_code": "/* \n===============================================================================\nModel Name : daily_sales_summary\nDescription: Summarizes daily sales performance using parameterized filters.\n\nParameters:\n  - analysis_date: Target transaction date (YYYY-MM-DD)\n  - order_status : Filter by status ('completed', 'pending', etc.)\n  - target_region: Specific region name or 'All' to aggregate all regions\n\nBusiness Logic:\n  - Dynamically includes/excludes region-based WHERE clauses using Jinja.\n===============================================================================\n*/\n\nSELECT\n    order_date,\n    region,\n    COUNT(*) as order_count,\n    SUM(total_amount) as total_sales,\n    AVG(total_amount) as avg_order_value,\n    -- Conditional Aggregation Example (Step 5 Requirement)\n    SUM(CASE WHEN total_amount > 200 THEN 1 ELSE 0 END) as high_value_order_count\nFROM \"dev\".\"main\".\"raw_orders\"\nWHERE order_date = '2024-01-15'\n  AND status = 'completed'\n  \nGROUP BY order_date, region", "relation_name": "\"dev\".\"main\".\"daily_sales_summary\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-11T05:31:36.863557Z", "completed_at": "2026-09-11T05:31:36.878473Z"}, {"name": "execute", "started_at": "2026-09-11T05:31:36.880058Z", "completed_at": "2026-09-11T05:31:36.880076Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.01948237419128418, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.dynamic_dbt_project.sales_summary_parameterized", "compiled": true, "compiled_code": "\n\nWITH date_range AS (\n    \n    \n    \n    SELECT \n        '2024-01-01'::DATE AS start_period,\n        '2024-03-01'::DATE AS end_period\n\n)\nSELECT\n    date_trunc('month', o.order_date) AS order_month,\n    o.region,\n    sum(o.total_amount) AS total_sales\nFROM \"dev\".\"main\".\"raw_orders\" o\nCROSS JOIN date_range d\nWHERE o.order_date >= d.start_period\n  AND o.order_date < d.end_period\n  AND o.status = 'completed'\nGROUP BY 1, 2", "relation_name": "\"dev\".\"main\".\"sales_summary_parameterized\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-11T05:31:36.885597Z", "completed_at": "2026-09-11T05:31:36.908539Z"}, {"name": "execute", "started_at": "2026-09-11T05:31:36.910334Z", "completed_at": "2026-09-11T05:31:36.910352Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.027103424072265625, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.dynamic_dbt_project.not_null_my_second_dbt_model_id.151b76d778", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect id\nfrom \"dev\".\"main\".\"my_second_dbt_model\"\nwhere id is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-11T05:31:36.916192Z", "completed_at": "2026-09-11T05:31:36.931745Z"}, {"name": "execute", "started_at": "2026-09-11T05:31:36.932884Z", "completed_at": "2026-09-11T05:31:36.932897Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.019822359085083008, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.dynamic_dbt_project.unique_my_second_dbt_model_id.57a0f8c493", "compiled": true, "compiled_co